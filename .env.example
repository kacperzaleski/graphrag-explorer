# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM (chat: extraction + answering) -------------------------------------------
# One of: gemini | cerebras | mistral | groq  (presets live in backend/config.py)
LLM_PROVIDER=gemini
# Optional: override the preset's default model (empty = preset default), e.g. gemini-3.8-flash
# LLM_MODEL=

# --- Embeddings ---------------------------------------------------------------------
# One of: gemini | mistral  (Cerebras and Groq have no embeddings API)
# Changing this changes the vector dimension -> re-run ingestion.
EMBED_PROVIDER=gemini
# EMBED_MODEL=

# --- API keys: one per provider, so switching is a one-line change above -------------
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Generic fallback, used when the provider-specific key is empty
# LLM_API_KEY=

# --- Neo4j ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local dev only; Neo4j requires at least 8 characters. Also read by docker-compose.yml.
NEO4J_PASSWORD=graphrag-dev-password
